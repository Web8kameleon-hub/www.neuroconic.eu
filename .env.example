# Porta publike HTTP. Për HTTPS përdor reverse proxy/CDN para kësaj porte.
HTTP_PORT=80

# Porta publike HTTPS (TLS terminohet nga vetë nginx me certifikatë origin).
HTTPS_PORT=443

# Folderi lokal me origin.pem + origin.key (Cloudflare Origin Certificate).
TLS_CERT_DIR=./deploy/certs

# Origjinat që lejohen të thërrasin API-n direkt, të ndara me presje.
CORS_ORIGINS=https://neurosonic.eu,https://www.neurosonic.eu

# Modeli Ollama i ngarkuar automatikisht nga shërbimi ollama-pull dhe
# i përdorur nga backend/api/shell/think për gjenerim real teksti
# (kodim + bisedë). Shiko https://ollama.com/library për alternativa.
OLLAMA_MODEL=qwen2.5:7b

# --- Autentikim (backend/main.py + neurosonic_auth.py) ---
# Sekret për nënshkrimin e JWT-ve. GJENERO NJË VLERË TË RE, TË RASTËSISHME
# dhe TË FSHEHTË për prodhim (p.sh. `python -c "import secrets; print(secrets.token_hex(32))"`).
# MOS e lër vlerën default në prodhim.
NEUROSONIC_AUTH_SECRET=change-me-to-a-random-secret-in-production

# --- Pagesa (backend/main.py + neurosonic_payments.py) ---
# Çelësi sekret i Stripe (Developers > API keys). Fillon me sk_live_ ose sk_test_.
STRIPE_SECRET_KEY=

# Sekreti i endpoint-it webhook (Developers > Webhooks > endpoint-i juaj). Fillon me whsec_.
STRIPE_WEBHOOK_SECRET=

# Opsionale: nëse keni disa "event destinations" Stripe mbi të njëjtin endpoint URL
# (p.sh. një me payload "snapshot" dhe një me payload "thin"), vendosni sekretin
# shtesë këtu — do të provohet gjithashtu kundrejt nënshkrimit hyrës.
STRIPE_WEBHOOK_SECRET_SNAPSHOT=
STRIPE_WEBHOOK_SECRET_THIN=

# ID e Price-it "One-off" 1 EUR (jo recurring!) për "Neurosonic 1-Day Unlimited Access".
STRIPE_PRICE_ID=

# URL-të ku ridrejtohet përdoruesi pas Checkout-it te Stripe.
STRIPE_SUCCESS_URL=https://www.neurosonic.eu/dashboard?paid=1
STRIPE_CANCEL_URL=https://www.neurosonic.eu/pricing

