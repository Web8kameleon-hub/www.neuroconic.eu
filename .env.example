# Porta publike HTTP. Për HTTPS përdor reverse proxy/CDN para kësaj porte.
HTTP_PORT=80

# Porta publike HTTPS (TLS terminohet nga vetë nginx me certifikatë origin).
HTTPS_PORT=443

# Folderi lokal me origin.pem + origin.key (Cloudflare Origin Certificate).
TLS_CERT_DIR=./deploy/certs

# Origjinat që lejohen të thërrasin API-n direkt, të ndara me presje.
CORS_ORIGINS=https://neurosonic.eu,https://www.neurosonic.eu

# Modeli Ollama i ngarkuar automatikisht nga shërbimi ollama-pull dhe
# i përdorur nga backend/api/shell/think për gjenerim real teksti
# (kodim + bisedë). Shiko https://ollama.com/library për alternativa.
OLLAMA_MODEL=deepseek-r1:7b
