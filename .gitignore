# NEUROSONIC - GitIgnore v1.0
__pycache__/
*.py[cod]
*$py.class
*.so
.env
venv/
.venv/
.mypy_cache/
.pytest_cache/
*.egg-info/
dist/
build/
package-lock.json
node_modules/
.DS_Store
Thumbs.db
*.log
logs/*.log
memory/*.json
memory/long_term/*
memory/working/*
memory/session/*
!memory/.gitkeep
!logs/.gitkeep
.gitkeep
